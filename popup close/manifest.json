{
  "manifest_version": 3,
  "name": "Popup & Redirect Closer",
  "version": "1.1.0",
  "description": "Instantly closes popups, redirects, blank links, and off-site tabs as soon as they open.",
  "minimum_chrome_version": "102",
  "permissions": [
    "tabs",
    "webNavigation",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Popup & Redirect Closer",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
